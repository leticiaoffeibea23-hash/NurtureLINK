# NurtureLink — root environment example
# Copy relevant sections into apps/mobile/.env, packages/api/.env, apps/admin/.env

# ── API ──────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/nurturelink"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
PORT=3000

# ── Claude / Anthropic (primary LLM) ────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# ── DeepSeek (fallback LLM — optional) ──────────────────────────────────────
# If set, DeepSeek is used automatically when Claude is unavailable or errors.
# Leave blank to disable the fallback.
DEEPSEEK_API_KEY="sk-..."
DEEPSEEK_MODEL="deepseek-chat"

# ── Object Storage (S3-compatible) ───────────────────────────────────────────
S3_ENDPOINT="https://s3.amazonaws.com"
S3_BUCKET="nurturelink-assets"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"

# ── Admin ────────────────────────────────────────────────────────────────────
VITE_API_URL="http://localhost:3000"
